## 6.2 Evrensel Hard Lock Kuralları

```typescript
// core/policy/hard-locks.ts

// HARD LOCK 1: Değiştirilemez durum koruması
const immutableStateGuard: PolicyFn = (d) => {
  const locked = DomainConfig.getLockedStates(d.category);
  const state  = d.payload.params.current_status as string;
  if (locked.includes(state) && d.intent !== "READ_DATA")
    return { decision: "DENY", priority: 1, error_code: "IMMUTABLE_STATE",
      redirect: `"${state}" durumundaki kayıt değiştirilemez.` };
  return null;
};

// HARD LOCK 2: Negatif/sıfır değer engeli
const nonNegativeGuard: PolicyFn = (d) => {
  for (const field of DomainConfig.getNonNegativeFields(d.category)) {
    const v = d.payload.params[field] as number;
    if (v !== undefined && v <= 0)
      return { decision: "DENY", priority: 1, error_code: "NON_POSITIVE_VALUE",
        redirect: `"${field}" sıfır veya negatif olamaz.` };
  }
  return null;
};

// HARD LOCK 3: CRITICAL risk → insan onayı zorunlu
const criticalHumanGate: PolicyFn = (d) => {
  if (d.context.risk_level === "CRITICAL")
    return { decision: "ASK_HUMAN", priority: 1,
      error_code: "HUMAN_APPROVAL_REQUIRED",
      redirect: "Kritik risk. Dashboard üzerinden manuel onay gerekiyor." };
  return null;
};

// HARD LOCK 4: Kaynak sahibi değilse yazma yasak
const ownershipGuard: PolicyFn = (d) => {
  if (d.intent === "READ_DATA") return null;
  const owner = d.payload.params.owner_id as string;
  if (owner && owner !== d.context.actor_id &&
      !DomainConfig.getPrivilegedRoles().includes(d.context.actor_role))
    return { decision: "DENY", priority: 1, error_code: "NOT_RESOURCE_OWNER",
      redirect: "Bu kaynağa erişim yetkiniz yok." };
  return null;
};
```

## 6.3 Domain Politika Şablonu

```typescript
// domain/[proje]/policies.ts

registerPolicy("role_action_guard", (d) => {
  const allowed = ROLE_ACTION_MAP[d.payload.action_name];
  if (!allowed) return null;
  if (!allowed.includes(d.context.actor_role))
    return { decision: "DENY", priority: 2, error_code: "UNAUTHORIZED_ROLE",
      redirect: `Bu eylemi "${allowed.join(", ")}" rolü yapabilir.` };
  return null;
}, 2);

registerPolicy("numeric_limit_guard", (d) => {
  const limits = DomainConfig.getFieldLimits(d.category, d.payload.action_name);
  for (const [field, { min, max }] of Object.entries(limits)) {
    const v = d.payload.params[field] as number;
    if (min !== undefined && v < min)
      return { decision: "DENY", priority: 3, error_code: "BELOW_MINIMUM",
        redirect: `"${field}" minimum ${min} olmalı. Girilen: ${v}` };
    if (max !== undefined && v > max)
      return { decision: "DENY", priority: 3, error_code: "EXCEEDS_MAXIMUM",
        redirect: `"${field}" maksimum ${max} olabilir. Girilen: ${v}` };
  }
  return null;
}, 3);

// Bakım modu
registerPolicy("maintenance_guard", (d) => {
  if (SystemState.isMaintenanceMode() && d.intent !== "READ_DATA")
    return { decision: "DENY", priority: 3, error_code: "MAINTENANCE_WINDOW_ACTIVE",
      redirect: "Sistem bakım modunda. Sadece okuma yapılabilir." };
  return null;
}, 3);

// Proje başında doldurulur:
