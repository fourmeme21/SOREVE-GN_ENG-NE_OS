## 7.1 applyPatch (dry-run)

```javascript
function applyPatch(original, operations) {
  let updated = original;
  for (const op of operations) {
    if (!updated.includes(op.search)) throw "SEARCH_NOT_FOUND";
    updated = updated.replace(op.search, op.replace);
  }
  return updated;
}
```

## 7.2 Execution Gate Akışı

```javascript
// Tam execution akışı
original = readFile(file);

updated  = applyPatch(original, ops);   // dry-run
diff     = { before: original, after: updated };
print(diff);

if (user !== "y") exit();

try {
  writeFile(file, updated);
  logSession(session);
} catch (e) {
  writeFile(file, original);    // rollback
  throw "ROLLBACK_DONE";
}
