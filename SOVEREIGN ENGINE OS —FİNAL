```typescript
// core/types/decision.ts

type Intent =
  | "READ_DATA"       // Veri okuma          — düşük risk
  | "WRITE_DATA"      // Kayıt oluşturma     — orta risk
  | "EXECUTE_ACTION"  // İş akışı tetikleme  — yüksek risk
  | "TRIGGER_EVENT"   // Olay/bildirim       — orta risk
  | "MODIFY_STATE";   // Durum/config değişimi — kritik

type RiskLevel  = "LOW" | "MEDIUM" | "HIGH" | "CRITICAL";
type Confidence = "HIGH" | "MEDIUM" | "LOW";

interface Decision {
  id:         string;   // UUID v7
  created_at: string;   // ISO 8601
  intent:     Intent;
  category:   string;   // Domain tanımlar: "FINANCIAL" | "INVENTORY" | ...

  payload: {
    action_name:     string;
    params:          Record<string, unknown>;
    assumed_state?:  Record<string, unknown>; // AI'nın varsaydığı mevcut durum
  };

  context: {
    actor_id:        string;
    actor_role:      string;
    session_id:      string;
    risk_level:      RiskLevel;
    hierarchy_path?: string[];
  };

  metadata: {
    model:               string;
    session_number:      number;
    confidence:          Confidence;
    self_check_passed:   boolean;
    token_budget_spent?: number;
  };

  status:
    | "PENDING" | "VALIDATED" | "POLICY_APPROVED"
    | "EXECUTING" | "COMPLETED" | "REJECTED" | "BLOCKED";

  audit_hash?: string;
}
```

