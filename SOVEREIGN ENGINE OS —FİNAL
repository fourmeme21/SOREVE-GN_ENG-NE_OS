## 7.3 Idempotency (Mükerrer İşlem Engeli)

```typescript
// core/gate/idempotency.ts

function generateKey(d: Decision): string {
  const window = Math.floor(Date.now() / 5000); // 5 saniyelik pencere
  return crypto.createHash("sha256").update(JSON.stringify({
    actor:  d.context.actor_id,
    action: d.payload.action_name,
    params: d.payload.params,
    window
  })).digest("hex");
}

class IdempotencyStore {
  private store = new Map<string, { result: unknown; ts: number }>();
  private TTL   = 30_000;

  async check(key: string) {
    const e = this.store.get(key);
    if (!e || Date.now() - e.ts > this.TTL) { this.store.delete(key); return { found: false }; }
    return { found: true, cached: e.result };
  }

  async set(key: string, result: unknown) {
    this.store.set(key, { result, ts: Date.now() });
  }
}
```

## 7.4 Fail-Closed Garantisi

```typescript
// Şüpheli durumda ALWAYS DENY — asla izin verme

async function executeWithFailClosed<T>(
  operation: () => Promise<T>,
  timeoutMs = 5000
): Promise<T> {
  try {
    return await Promise.race([
      operation(),
      new Promise<never>((_, r) => setTimeout(() => r(new Error("POLICY_TIMEOUT")), timeoutMs))
    ]);
  } catch {
    throw new PolicyDeniedError("FAIL_CLOSED_TRIGGERED");
  }
}
```

## 7.5 Atomic File Transaction

```typescript
async function executeAtomically(bundleId: string, operations: FileOperation[]) {
  // 1. Yedek al
  const backups = new Map<string, string|null>();
  for (const op of operations) {
    if (op.operation !== "CREATE") backups.set(op.path, await readFileSafe(op.path));
  }

  // 2. Uygula
  try {
    for (const op of operations) await applyOperation(op);
    return { success: true };
  } catch {
    // 3. Rollback
    for (const [path, backup] of backups) {
      if (backup !== null) await writeFile(path, backup);
      else await deleteFileSafe(path);
    }
    return { success: false, rolled_back: true };
  }
}
```

## 7.6 Hata Senaryosu Tablosu

| Hata | Davranış |
|------|----------|
| `INVALID_SCHEMA` | İşlem iptal |
| `SEARCH_NOT_FOUND` | İşlem iptal |
| `WRITE_FAIL` | Rollback |
| `POLICY_TIMEOUT` | Fail-closed → DENY |
| `IMMUTABLE_STATE` | DENY |
| `UNKNOWN` | Rollback |

