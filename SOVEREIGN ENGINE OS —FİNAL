# BÖLÜM 5 — VALIDATION LAYER

## 5.1 Üç Aşamalı Protokol

### Aşama 1 — Şema Doğrulama

```typescript
// core/validation/schema.ts
import { z } from "zod";

export const DecisionSchema = z.object({
  id:         z.string().uuid(),
  created_at: z.string().datetime(),
  intent:     z.enum(["READ_DATA","WRITE_DATA","EXECUTE_ACTION","TRIGGER_EVENT","MODIFY_STATE"]),
  category:   z.string().min(1).max(50).regex(/^[A-Z_]+$/),
  payload: z.object({
    action_name:    z.string().min(1).regex(/^[a-z_]+$/),
    params:         z.record(z.unknown()),
    assumed_state:  z.record(z.unknown()).optional()
  }),
  context: z.object({
    actor_id:   z.string().min(1),
    actor_role: z.string().min(1),
    session_id: z.string().min(1),
    risk_level: z.enum(["LOW","MEDIUM","HIGH","CRITICAL"])
  }),
  metadata: z.object({
    model:             z.string().min(1),
    session_number:    z.number().int().positive(),
    confidence:        z.enum(["HIGH","MEDIUM","LOW"]),
    self_check_passed: z.boolean()
  })
});

export function validateSchema(raw: unknown): ValidationResult {
  const result = DecisionSchema.safeParse(raw);
  if (!result.success) {
    return { status: "REJECTED", reason: result.error.issues
      .map(i => `[${i.path.join(".")}] ${i.message}`).join(" | ") };
  }
  // HIGH confidence + self_check_passed=false → çelişki
  if (result.data.metadata.confidence === "HIGH" &&
      !result.data.metadata.self_check_passed) {
    return { status: "REJECTED",
      reason: "HIGH confidence ama self_check_passed=false. Çelişki." };
  }
  return { status: "PASS", data: result.data as Decision };
}
```

### Aşama 2 — İş Kuralları

```typescript
// core/validation/business.ts

export function validateBusinessRules(d: Decision): ValidationResult {
  const errors: string[] = [];

  // MODIFY_STATE → her zaman CRITICAL
  if (d.intent === "MODIFY_STATE" && d.context.risk_level !== "CRITICAL")
    errors.push("MODIFY_STATE için risk_level CRITICAL olmalı");

  // CRITICAL risk → confidence HIGH olamaz
  if (d.context.risk_level === "CRITICAL" && d.metadata.confidence === "HIGH")
    errors.push("CRITICAL risk'te AI HIGH confidence beyan edemez");

  // assumed_state → sadece EXECUTE_ACTION veya MODIFY_STATE
  if (d.payload.assumed_state &&
      !["EXECUTE_ACTION","MODIFY_STATE"].includes(d.intent))
    errors.push("assumed_state yalnızca EXECUTE_ACTION/MODIFY_STATE ile kullanılabilir");

  return errors.length > 0
    ? { status: "REJECTED", reason: errors.join(" | ") }
    : { status: "PASS", data: d };
}
```

### Aşama 3 — Pre-flight Read (Bayat Veri Koruması)

En kritik aşama. AI'nın varsaydığı veri ile sistemdeki gerçek veriyi karşılaştırır.

```typescript
// core/validation/preflight.ts

export interface PreFlightResult {
  clear:              boolean;
  reason?:            "RE_EVALUATE" | "ENTITY_INACTIVE" | "STATE_CHANGED";
  stale_fields?:      string[];
  current_snapshot?:  Record<string, unknown>;
}

// Domain adaptörü bu arayüzü implemente eder:
export interface PreFlightReader {
  read(decision: Decision): Promise<PreFlightResult>;
}

// Örnek domain implementasyonu:
export class ProjectPreFlightReader implements PreFlightReader {
  constructor(private db: DatabaseClient) {}

  async read(d: Decision): Promise<PreFlightResult> {
    if (!d.payload.assumed_state) return { clear: true };

    const fresh = await this.db.table(this.categoryToTable(d.category))
      .where({ id: d.context.actor_id }).first();

    if (!fresh) return { clear: false, reason: "ENTITY_INACTIVE" };

    const staleDiff = Object.keys(d.payload.assumed_state).filter(key => {
      const a = d.payload.assumed_state![key];
      const f = fresh[key];
      if (typeof a === "number" && typeof f === "number")
        return Math.abs(a - f) > 0.001;
      return a !== f;
    });

    return staleDiff.length > 0
      ? { clear: false, reason: "RE_EVALUATE",
          stale_fields: staleDiff, current_snapshot: fresh }
      : { clear: true };
  }
}
```

