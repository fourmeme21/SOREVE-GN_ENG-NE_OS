## BÖLÜM 4 — VALIDATION ENGINE

### 4.1 Üç Aşamalı Protokol

**Aşama 1 — Şema Doğrulama**

```typescript
// core/validation/schema.ts
import { z } from "zod";

export const DecisionSchema = z.object({
  id: z.string().uuid(),
  created_at: z.string().datetime(),
  intent: z.enum(["READ_DATA", "WRITE_DATA", "EXECUTE_ACTION", "TRIGGER_EVENT", "MODIFY_STATE"]),
  category: z.string().min(1).max(50).regex(/^[A-Z_]+$/, "Büyük harf ve alt çizgi"),
  payload: z.object({
    action_name: z.string().min(1).regex(/^[a-z_]+$/, "Küçük harf ve alt çizgi"),
    params: z.record(z.unknown()),
    assumed_state: z.record(z.unknown()).optional()
  }),
  context: z.object({
    actor_id: z.string().min(1),
    actor_role: z.string().min(1),
    session_id: z.string().min(1),
    risk_level: z.enum(["LOW", "MEDIUM", "HIGH", "CRITICAL"])
  }),
  metadata: z.object({
    model: z.string().min(1),
    session_number: z.number().int().positive(),
    confidence: z.enum(["HIGH", "MEDIUM", "LOW"]),
    self_check_passed: z.boolean()
  })
});

export type ValidationResult =
  | { status: "PASS"; data: Decision }
  | { status: "REJECTED"; reason: string };

export function validateSchema(raw: unknown): ValidationResult {
  const result = DecisionSchema.safeParse(raw);
  if (!result.success) {
    return {
      status: "REJECTED",
      reason: result.error.issues
        .map(i => `[${i.path.join(".")}] ${i.message}`)
        .join(" | ")
    };
  }
  // HIGH confidence ile self_check_passed=false olamaz
  if (result.data.metadata.confidence === "HIGH" &&
      !result.data.metadata.self_check_passed) {
    return {
      status: "REJECTED",
      reason: "HIGH confidence beyan edilmiş ama self_check_passed=false. Çelişki."
    };
  }
  return { status: "PASS", data: result.data as Decision };
}
```

**Aşama 2 — İş Kuralları Doğrulama**

Bu katman domain-bağımsız evrensel kuralları kontrol eder. Domain-spesifik kurallar Policy Engine'e aittir.

```typescript
// core/validation/business.ts

export function validateBusinessRules(decision: Decision): ValidationResult {
  const errors: string[] = [];

  // Kural 1: MODIFY_STATE her zaman CRITICAL olmalı
  if (decision.intent === "MODIFY_STATE" &&
      decision.context.risk_level !== "CRITICAL") {
    errors.push("MODIFY_STATE intent için risk_level CRITICAL olmalıdır");
  }

  // Kural 2: CRITICAL risk → confidence HIGH olamaz (insan kontrolü gerekir)
  if (decision.context.risk_level === "CRITICAL" &&
      decision.metadata.confidence === "HIGH") {
    errors.push("CRITICAL risk seviyesinde AI HIGH confidence beyan edemez");
  }

  // Kural 3: assumed_state varsa EXECUTE_ACTION olmalı
  if (decision.payload.assumed_state &&
      !["EXECUTE_ACTION", "MODIFY_STATE"].includes(decision.intent)) {
    errors.push("assumed_state yalnızca EXECUTE_ACTION veya MODIFY_STATE ile kullanılabilir");
  }

  return errors.length > 0
    ? { status: "REJECTED", reason: errors.join(" | ") }
    : { status: "PASS", data: decision };
}
```

**Aşama 3 — Pre-flight Read (Bayat Veri Koruması)**

Bu en kritik aşama. AI karar verirken sahip olduğu veri ile sistemdeki gerçek veri arasındaki farkı tespit eder.

```typescript
// core/validation/preflight.ts

export interface PreFlightResult {
  clear: boolean;
  reason?: "RE_EVALUATE" | "ENTITY_INACTIVE" | "STATE_CHANGED";
  stale_fields?: string[];
  current_snapshot?: Record<string, unknown>;
}

// Bu fonksiyon domain adaptörü tarafından implemente edilir
// Core sadece arayüzü tanımlar
export interface PreFlightReader {
  read(decision: Decision): Promise<PreFlightResult>;
}

// Varsayılan: assumed_state yoksa geç
export class DefaultPreFlightReader implements PreFlightReader {
  async read(decision: Decision): Promise<PreFlightResult> {
    if (!decision.payload.assumed_state) return { clear: true };
    // assumed_state varsa domain adaptörü override etmeli
    return { clear: true };
  }
}
```

**Domain adaptörü pre-flight implementasyonu (örnek kalıp):**

```typescript
// domain/[proje]/preflight.ts
// Kullanıcı kendi veri kaynağına göre bunu implement eder

export class ProjectPreFlightReader implements PreFlightReader {
  constructor(private db: DatabaseClient) {}

  async read(decision: Decision): Promise<PreFlightResult> {
    if (!decision.payload.assumed_state) return { clear: true };

    // Hangi entity'yi kontrol edeceğini category'den anlar
    const entityId = decision.context.actor_id;
    const category = decision.category;

    // Domain'e özgü fresh state okuma
    const freshState = await this.db
      .table(this.categoryToTable(category))
      .where({ id: entityId })
      .first();

    if (!freshState) return { clear: false, reason: "ENTITY_INACTIVE" };

    // Kritik alanları karşılaştır
    const staleDiff = this.detectStaleness(
      decision.payload.assumed_state,
      freshState
    );

    if (staleDiff.length > 0) {
      return {
        clear: false,
        reason: "RE_EVALUATE",
        stale_fields: staleDiff,
        current_snapshot: freshState
      };
    }

    return { clear: true };
  }

  private detectStaleness(
    assumed: Record<string, unknown>,
    fresh: Record<string, unknown>
  ): string[] {
    return Object.keys(assumed).filter(key => {
      if (typeof assumed[key] === "number" && typeof fresh[key] === "number") {
        return Math.abs((assumed[key] as number) - (fresh[key] as number)) > 0.001;
      }
      return assumed[key] !== fresh[key];
    });
  }

  private categoryToTable(category: string): string {
    // Domain mapping: kullanıcı tanımlar
    throw new Error(`categoryToTable not implemented for: ${category}`);
  }
}
```

