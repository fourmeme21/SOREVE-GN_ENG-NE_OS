### 6.2 Fail-Closed Garantisi

```typescript
// core/gate/fail-closed.ts

// SİSTEMİN EN KRİTİK KURALI:
// Şüpheli durumda varsayılan karar her zaman DENY

const DENY_REASONS = [
  "POLICY_TIMEOUT",
  "POLICY_SERVICE_UNAVAILABLE",
  "UNKNOWN_INTENT",
  "SIGNATURE_INVALID",
  "LICENSE_EXPIRED",
  "UNKNOWN_ERROR"
] as const;

async function executeWithFailClosed<T>(
  operation: () => Promise<T>,
  timeoutMs: number = 5000
): Promise<T | never> {

  const timeoutPromise = new Promise<never>((_, reject) =>
    setTimeout(() => reject(new Error("POLICY_TIMEOUT")), timeoutMs)
  );

  try {
    return await Promise.race([operation(), timeoutPromise]);
  } catch (err) {
    // Herhangi bir hata → DENY, asla izin ver değil
    const reason = DENY_REASONS.find(r =>
      String(err).includes(r)
    ) ?? "UNKNOWN_ERROR";

    throw new PolicyDeniedError(reason);
  }
}
```

### 6.3 Atomic File Transaction (The Bridge için)

```typescript
// core/gate/atomic-transaction.ts

interface FileOperation {
  operation: "CREATE" | "UPDATE" | "DELETE";
  path: string;
  content?: string;
}

async function executeAtomically(
  bundleId: string,
  operations: FileOperation[]
): Promise<{ success: boolean; rolled_back?: boolean }> {

  // 1. Yedek al
  const backups = new Map<string, string | null>();
  for (const op of operations) {
    if (op.operation !== "CREATE") {
      const existing = await readFileSafe(op.path);
      backups.set(op.path, existing);
    }
  }

  // 2. Checkpoint oluştur
  const checkpoint = {
    bundle_id: bundleId,
    started_at: Date.now(),
    completed: [] as string[],
    status: "IN_PROGRESS" as string
  };
  await writeCheckpoint(bundleId, checkpoint);

  // 3. İşlemleri uygula
  try {
    for (const op of operations) {
      await applyOperation(op);
      checkpoint.completed.push(op.path);
      await writeCheckpoint(bundleId, checkpoint);
    }
    checkpoint.status = "COMPLETED";
    await writeCheckpoint(bundleId, checkpoint);
    return { success: true };

  } catch (err) {
    // 4. Rollback
    for (const [path, backup] of backups) {
      if (backup !== null) await writeFile(path, backup);
      else await deleteFileSafe(path);
    }
    checkpoint.status = "ROLLED_BACK";
    await writeCheckpoint(bundleId, checkpoint);
    return { success: false, rolled_back: true };
  }
}
```

### 6.4 Hata Senaryosu Tablosu

| Senaryo | Risk | Yanıt |
|---------|------|-------|
| Aynı istek 2 kez | Mükerrer işlem | Idempotency → önceki sonucu döndür |
| Bayat veri tespiti | Yanlış kararlar | Pre-flight → RE_EVALUATE sinyali |
| Politika timeout | Belirsiz durum | Fail-closed → DENY |
| Bridge kısmen çalıştı | Tutarsız dosyalar | Atomic rollback |
| Değiştirilemez kayıt | Veri bozulması | IMMUTABLE_STATE → DENY |
| Bilinmeyen intent | Bypass girişimi | Default DENY |

