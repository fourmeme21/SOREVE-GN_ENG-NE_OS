// domain/[proje]/policies.ts

import { registerPolicy } from "../../core/policy/registry";

// POLİTİKA 1: Rol tabanlı eylem kısıtlaması
registerPolicy("role_action_guard", (d) => {
  const allowedRoles = ROLE_ACTION_MAP[d.payload.action_name];
  if (!allowedRoles) return null; // bu eylem için kısıt yok

  if (!allowedRoles.includes(d.context.actor_role)) {
    return {
      decision: "DENY",
      priority: 2,
      error_code: "UNAUTHORIZED_ROLE",
      redirect: `Bu eylemi "${allowedRoles.join(", ")}" rolü yapabilir. Sizin rolünüz: ${d.context.actor_role}`
    };
  }
  return null;
}, 2);

// POLİTİKA 2: Hiyerarşi yönü kısıtlaması (varsa)
registerPolicy("hierarchy_direction_guard", (d) => {
  if (!d.context.hierarchy_path) return null;
  const direction = d.payload.params.direction as string;
  const allowedDirection = DomainConfig.getAllowedHierarchyDirection(d.payload.action_name);

  if (allowedDirection && direction !== allowedDirection) {
    return {
      decision: "DENY",
      priority: 2,
      error_code: "INVALID_HIERARCHY_DIRECTION",
      redirect: `Bu işlem yalnızca ${allowedDirection} yönünde çalışır.`
    };
  }
  return null;
}, 2);

// POLİTİKA 3: Nümerik limit kontrolü
registerPolicy("numeric_limit_guard", (d) => {
  const limits = DomainConfig.getFieldLimits(d.category, d.payload.action_name);
  for (const [field, { min, max }] of Object.entries(limits)) {
    const value = d.payload.params[field] as number;
    if (value === undefined) continue;
    if (min !== undefined && value < min) {
      return {
        decision: "DENY",
        priority: 3,
        error_code: "BELOW_MINIMUM",
        redirect: `"${field}" değeri minimum ${min} olmalıdır. Girilen: ${value}`
      };
    }
    if (max !== undefined && value > max) {
      return {
        decision: "DENY",
        priority: 3,
        error_code: "EXCEEDS_MAXIMUM",
        redirect: `"${field}" değeri maksimum ${max} olabilir. Girilen: ${value}`
      };
    }
  }
  return null;
}, 3);

// POLİTİKA 4: Operasyonel pencere kontrolü (bakım modü vs.)
registerPolicy("operational_window_guard", (d) => {
  const maintenanceMode = SystemState.isMaintenanceMode();
  const exemptIntents: Intent[] = ["READ_DATA"];

  if (maintenanceMode && !exemptIntents.includes(d.intent)) {
