## BÖLÜM 6 — EXECUTION GATE

### 6.1 Idempotency — Mükerrer İşlem Engeli

```typescript
// core/gate/idempotency.ts

// Idempotency key üretim formülü
// 5 saniyelik zaman penceresi: aynı anahtar → önceki sonucu döndür
function generateKey(decision: Decision): string {
  const window = Math.floor(Date.now() / 5000);
  const payload = JSON.stringify({
    actor: decision.context.actor_id,
    action: decision.payload.action_name,
    params: decision.payload.params,
    window
  });
  return crypto.createHash("sha256").update(payload).digest("hex");
}

class IdempotencyStore {
  private store = new Map<string, { result: unknown; timestamp: number }>();
  private TTL_MS = 30_000; // 30 saniye cache

  async check(key: string): Promise<{ found: boolean; cached?: unknown }> {
    const entry = this.store.get(key);
    if (!entry) return { found: false };
    if (Date.now() - entry.timestamp > this.TTL_MS) {
      this.store.delete(key);
      return { found: false };
    }
    return { found: true, cached: entry.result };
  }

  async set(key: string, result: unknown): Promise<void> {
    this.store.set(key, { result, timestamp: Date.now() });
  }
}

// Yüksek yük senaryoları için Redis implementasyonu:
// class RedisIdempotencyStore implements IdempotencyStore { ... }
