// core/adapter/types.ts

interface AdapterResult {
  success: boolean;
  data?: unknown;
  error?: string;
  error_code?: string;
}

interface DomainAdapter {
  // Hangi karar nesnelerini işleyebileceğini söyler
  supports(decision: Decision): boolean;

  // Onaylanan kararı gerçek sisteme taşır
  // Tüm domain bilgisi burada toplanır
  execute(decision: Decision): Promise<AdapterResult>;

  // Pre-flight okuma (opsiyonel — override edilebilir)
  preFlightReader?: PreFlightReader;
}

class AdapterRegistry {
  private adapters: DomainAdapter[] = [];

  register(adapter: DomainAdapter): void {
    this.adapters.push(adapter);
  }

  resolve(decision: Decision): DomainAdapter {
    const adapter = this.adapters.find(a => a.supports(decision));
    if (!adapter) {
      throw new Error(
        `No adapter found for: intent=${decision.intent}, category=${decision.category}`
      );
    }
    return adapter;
  }
}
