### 5.3 Evrensel Hard Lock Kuralları

Bu kurallar her projede geçerlidir, domain bilgisi içermez:

```typescript
// core/policy/hard-locks.ts

// HARD LOCK 1: Değiştirilemez durum koruması
// "locked_states" listesi domain adaptörü tarafından sağlanır
const immutableStateGuard: PolicyFn = (d) => {
  const lockedStates = DomainConfig.getLockedStates(d.category);
  const currentState = d.payload.params.current_status as string;

  if (lockedStates.includes(currentState) && d.intent !== "READ_DATA") {
    return {
      decision: "DENY",
      priority: 1,
      error_code: "IMMUTABLE_STATE",
      redirect: `"${currentState}" durumundaki kayıt değiştirilemez. Yalnızca okuma yapılabilir.`
    };
  }
  return null;
};

// HARD LOCK 2: Negatif/sıfır sayısal değer
// Hangi alanların negatif olamayacağını domain tanımlar
const nonNegativeGuard: PolicyFn = (d) => {
  const criticalFields = DomainConfig.getNonNegativeFields(d.category);
  for (const field of criticalFields) {
    const value = d.payload.params[field] as number;
    if (value !== undefined && value <= 0) {
      return {
        decision: "DENY",
        priority: 1,
        error_code: "NON_POSITIVE_VALUE",
        redirect: `"${field}" alanı sıfır veya negatif olamaz. Geçerli bir değer girin.`
      };
    }
  }
  return null;
};

// HARD LOCK 3: CRITICAL risk → insan onayı zorunlu
const criticalHumanGate: PolicyFn = (d) => {
  if (d.context.risk_level === "CRITICAL") {
    return {
      decision: "ASK_HUMAN",
      priority: 1,
      error_code: "HUMAN_APPROVAL_REQUIRED",
      redirect: "Bu işlem kritik risk seviyesinde. Dashboard üzerinden manuel onay gerekiyor."
    };
  }
  return null;
};

// HARD LOCK 4: Kaynak sahibi değilse READ_DATA dışında yasak
const ownershipGuard: PolicyFn = (d) => {
  if (d.intent === "READ_DATA") return null;
  const resourceOwner = d.payload.params.owner_id as string;
  if (resourceOwner && resourceOwner !== d.context.actor_id) {
    const actorRole = d.context.actor_role;
    const privilegedRoles = DomainConfig.getPrivilegedRoles();
    if (!privilegedRoles.includes(actorRole)) {
      return {
        decision: "DENY",
        priority: 1,
        error_code: "NOT_RESOURCE_OWNER",
        redirect: "Bu kaynağa erişim yetkiniz yok."
      };
    }
  }
  return null;
};
```

